# Copy to .env and adjust. Only ports and the link to the Temporal UI live here;
# everything else is configured in the web UI.
STONEPEDIA_PORT=8080
TEMPORAL_UI_PORT=8233
# Optional: full address of the Temporal UI if it is not on this host at TEMPORAL_UI_PORT.
# TEMPORAL_UI_URL=http://stonepedia.intra:8233
# Time zone for maintenance schedules (IANA name).
TIMEZONE=Asia/Seoul
